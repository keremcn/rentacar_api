# Optional: protect all /api/* routes except /api/health and /
# Clients must send header: x-api-key: <value>
API_KEY=

# Upstream site origin (Filoplan proxy)
ILKRENTACAR_BASE_URL=https://www.ilkrentacar.com

# Optional Bearer token for GET /api/reservations/:id
# (site /api/reservations requires auth)
UPSTREAM_AUTH_TOKEN=
